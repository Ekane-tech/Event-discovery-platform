web: mkdir -p /app/storage/app/public && php artisan storage:link --force && php artisan config:clear && php artisan route:clear && php artisan view:clear && php artisan optimize:clear && php artisan serve --host 0.0.0.0 --port $PORT
# Worker --timeout=130: must be > the longest job's $timeout (120s for the
# NotchPay charge + webhook jobs) or the worker kills us mid-write.
worker: php artisan config:clear && php artisan optimize:clear && php artisan queue:work redis --tries=3 --timeout=130 --sleep=3
scheduler: php artisan schedule:work