APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Cloudflare R2 Configuration (Recommended for production)
# R2 is S3-compatible with NO egress fees - perfect for high-traffic sites.
#
# Setting R2_BUCKET + R2_ACCESS_KEY_ID + R2_SECRET_ACCESS_KEY + R2_ENDPOINT
# on Railway is ALL you need: the app's 'public' disk (used by every image
# upload/read/delete path) automatically switches to Cloudflare R2. No code
# changes required. See CLOUDFLARE_R2_SETUP.md for the full walkthrough.
#
# R2_URL is optional but recommended in production: point it at a custom
# domain attached to the bucket (e.g. https://cdn.yourdomain.com). When unset,
# URLs fall back to the bucket-scoped R2 endpoint.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_DEFAULT_REGION=auto
R2_BUCKET=
R2_URL=
R2_ENDPOINT=
R2_USE_PATH_STYLE_ENDPOINT=false

# MeSomb Payment Gateway Configuration (https://mesomb.com)
#
# PAYMENT_PROVIDER:
#   - "mock"   : local dev, no external calls (default)
#   - "mesomb" : production — Cameroon mobile money (MTN / Orange) via MeSomb
#
# The user clicks "Pay" and the API responds in <1 second with
# "Check your phone and confirm the prompt". The charge call (which pushes
# the prompt to the phone) runs in a background queue job; the final status
# comes via the async, signature-verified webhook.
PAYMENT_PROVIDER=mock
# Credentials from the MeSomb dashboard (Account -> Developer).
MESOMB_APPLICATION_KEY=
MESOMB_ACCESS_KEY=
MESOMB_SECRET_KEY=
# Webhook signing secret (whsec_...), generated once when the webhook
# endpoint is created in the MeSomb dashboard. Required in production:
# callbacks are verified with HMAC-SHA256 over "<timestamp>.<raw body>"
# via the X-MeSomb-Webhook-Signature header.
MESOMB_WEBHOOK_SECRET=
# PROD = live money. MESOMB_ENV is informational (stored in payment
# metadata) unless you also override MESOMB_BASE_URL.
MESOMB_ENV=PROD
MESOMB_BASE_URL=https://mesomb.hachther.com
# Timeout for MeSomb API calls, in seconds.
MESOMB_TIMEOUT=60

VITE_APP_NAME="${APP_NAME}"
